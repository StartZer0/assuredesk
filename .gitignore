# Local credentials, customer data, models, databases and recovery material.
.env
.env.*
!.env.example
data/
*.sqlite*
*.ses
*.key
*.pem

# Python environment and disposable tool output.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.DS_Store
*.log

# Keep only reviewed evidence, never arbitrary runtime output or random recordings.
/output/*
!/output/dependency-licenses.json
!/output/development-retrieval.json
!/output/kimi-development-retrieval.json
!/output/kimi-release-manifest.json
!/output/release-manifest.json
!/output/restore-drill.json
!/output/validation-report.json
!/output/kimi-tests.xml
!/output/kimi-browser-tests.xml
!/output/review-fixes-tests.xml
!/output/review-fixes-browser-tests.xml
!/output/review-fixes-postgres-tests.xml
!/output/tests-kimi.xml
!/output/tests.xml
!/output/fixtures.jsonl
!/output/evaluation/
/output/evaluation/*
!/output/evaluation/*.json
!/output/evaluation/*.md
!/output/evaluation/*.zip
!/output/container/
/output/container/*
!/output/container/*.json
!/output/container/*.xml
!/output/playwright/
/output/playwright/*
!/output/playwright/inspectable-answer.png
!/output/playwright/assuredesk-three-minute-demo.webm
