# Copy to .env; never commit a real credential.
MOONSHOT_API_KEY=
GENERATION_MODEL=kimi-k3
GENERATION_INPUT_PRICE=6.00
GENERATION_OUTPUT_PRICE=15.00
DATABASE_URL=postgresql+psycopg://assuredesk:local-only@127.0.0.1:5432/assuredesk
OBJECT_ROOT=data/objects
EMBEDDING_CACHE=data/models
# Set only for a loopback HTTP development server. Use HTTPS and omit this for deployment.
LOCAL_HTTP=1
